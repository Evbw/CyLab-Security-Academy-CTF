#!/usr/bin/env python3
"""Crack level5: MD5 dictionary-attack the password, then XOR-decrypt the flag.

Expects dictionary.txt, level5.hash.bin, level5.flag.txt.enc in the same dir.
"""
import hashlib

DICT_FILE = "dictionary.txt"
HASH_FILE = "level5.hash.bin"
FLAG_FILE = "level5.flag.txt.enc"


def xor_decrypt(data: bytes, key: str) -> bytes:
    key_bytes = key.encode()
    return bytes(b ^ key_bytes[i % len(key_bytes)] for i, b in enumerate(data))


def main():
    target_hash = open(HASH_FILE, "rb").read()
    flag_enc = open(FLAG_FILE, "rb").read()

    with open(DICT_FILE) as f:
        for line in f:
            pw = line.strip()
            if hashlib.md5(pw.encode()).digest() == target_hash:
                print(f"password: {pw}")
                print(f"flag: {xor_decrypt(flag_enc, pw).decode()}")
                return
    print("no match found in dictionary")


if __name__ == "__main__":
    main()
